# Get these values from Twilio Console > Account Dashboard.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Use either an Auth Token or an API Key pair. API Keys are preferred for deployed apps.
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_api_key_secret

# Use ONE sender option. A Messaging Service is recommended as your messaging grows.
TWILIO_PHONE_NUMBER=+15551234567
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Set this to the HTTPS address Twilio can reach (for example, your deployed URL).
# It enables delivery-status callbacks and correct webhook signature validation.
PUBLIC_BASE_URL=https://your-domain.example

# 3000 is the default local port.
PORT=3000
NODE_ENV=development

# Optional: enables automatic AI replies to incoming SMS.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
SMS_ASSISTANT_INSTRUCTIONS=You are the helpful Benefit Bridge SMS assistant. Be warm, concise, and useful. Keep replies under 300 characters. Do not ask for passwords, account numbers, Social Security numbers, or other sensitive personal information. If a request needs a human, say so.

# Optional but strongly recommended on a public deployment. Both values are required to enable it.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=choose-a-long-unique-password

# Optional: use Vonage for custom outbound SMS on its hackathon trial.
# Twilio remains the inbound-webhook provider in this starter app.
SMS_PROVIDER=twilio
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_SENDER=Vonage APIs

# Voice (Vonage Application, JWT auth) — required for the renewal call bridge.
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY_PATH=./vonage-private.key
# Number the copilot calls on the user's behalf (the benefits office).
SNAP_OFFICE_NUMBER=+15551234567

# Shared secret for the Trigger.dev renewal reminder schedule.
OUTREACH_TOKEN=generate-a-long-random-value
