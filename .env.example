# Required. The agent runs on the OpenAI Agents SDK.
OPENAI_API_KEY=sk-...

# Optional. Defaults to the Agents SDK's default model when unset.
# OPENAI_DEFAULT_MODEL=gpt-5.6-luna

# Optional. When all three are set, texts go out over Vonage SMS instead of the console/web thread.
# Point your Vonage number's inbound SMS webhook at /api/sms/inbound (GET or POST).
# VONAGE_API_KEY=...
# VONAGE_API_SECRET=...
# VONAGE_SENDER=1707...           # your Vonage virtual number, digits only, or an approved alphanumeric sender

# Optional. Send every household's texts to this number instead of the one in profile.md.
# Handy for demoing on your own phone without editing tracked seed data.
# DEMO_PHONE=+1...

# Optional. Lets the agent place a spoken call (place_call tool) through the Vonage Voice API.
# Needs a Vonage Application with the voice capability; its private key goes in the file below
# (or inline in VONAGE_PRIVATE_KEY). Without these, calls print to the console.
# VONAGE_APPLICATION_ID=...
# VONAGE_PRIVATE_KEY_PATH=./vonage-private.key
# COPILOT_CALL_WINDOW=8-21          # New York hours during which calls may be placed

# The one phone number the agent tells households to call. Point it at a teammate's phone for
# demos; leave unset and the agent says "the number on your notice". No real agency number lives
# in the repo.
# SNAP_OFFICE_NUMBER=+1...

# Optional. Move the knowledge base somewhere else (defaults to ./data).
# DATA_DIR=./data
