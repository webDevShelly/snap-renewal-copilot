# Required. The agent runs on the OpenAI Agents SDK.
OPENAI_API_KEY=sk-...

# Optional. Defaults to the Agents SDK's default model when unset. (OPENAI_MODEL is ignored; it belongs to sms/.)
# OPENAI_DEFAULT_MODEL=gpt-5.6-luna

# Optional. When configured, texts go out over real SMS instead of the console/web thread.
# Point your Twilio number's inbound messaging webhook at POST /api/sms/inbound.
# Sender: TWILIO_FROM_NUMBER or TWILIO_PHONE_NUMBER. Auth: auth token, or an API key SID + secret.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_API_KEY_SID=SK...          # alternative to the auth token
# TWILIO_API_KEY_SECRET=...
# TWILIO_FROM_NUMBER=+1...

# Optional. Send every household's texts to this number instead of the one in profile.md.
# Handy for demoing on your own phone without editing tracked seed data.
# DEMO_PHONE=+1...

# Optional. Move the knowledge base somewhere else (defaults to ./data).
# DATA_DIR=./data
